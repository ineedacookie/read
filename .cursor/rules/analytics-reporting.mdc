# Analytics and Reporting Standards

## Query Optimization Patterns

### Use Database Aggregations Over Python Loops
```python
# ✅ GOOD: Database aggregation
stats = Log.objects.filter(
    school=school,
    date__range=(start_date, end_date)
).aggregate(
    total_logs=Count('id'),
    total_pages=Sum('pages'),
    total_minutes=Sum('minutes'),
    avg_rating=Avg('rating'),
    unique_students=Count('student', distinct=True)
)

# ❌ BAD: Python loops for aggregation
total_pages = 0
for log in logs:
    total_pages += log.pages or 0
```

### Use Select Related for Foreign Keys
```python
# ✅ GOOD: Efficient foreign key access
logs = Log.objects.select_related('student', 'school')\
                 .prefetch_related('student__classrooms')\
                 .filter(date__range=(start_date, end_date))

# ❌ BAD: N+1 query problem
logs = Log.objects.filter(date__range=(start_date, end_date))
for log in logs:
    print(log.student.name)  # Creates additional query for each log
```

## Date Range Handling Standards

### Consistent Date Range Validation
```python
def validate_date_range(start_date, end_date, max_days=90):
    """
    Standard date range validation for analytics
    """
    if not start_date or not end_date:
        raise ValueError("Both start_date and end_date are required")
        
    if start_date > end_date:
        raise ValueError("start_date cannot be after end_date")
        
    if (end_date - start_date).days > max_days:
        raise ValueError(f"Date range cannot exceed {max_days} days")
        
    return start_date, end_date
```

### Default Date Range Logic
```python
def get_default_date_range(period='month'):
    """
    Get standard date ranges for analytics
    """
    today = date.today()
    
    if period == 'week':
        start_date = today - timedelta(days=7)
    elif period == 'month':
        start_date = today.replace(day=1)
    elif period == 'quarter':
        quarter_start = ((today.month - 1) // 3) * 3 + 1
        start_date = today.replace(month=quarter_start, day=1)
    else:
        start_date = today - timedelta(days=30)
        
    return start_date, today
```

## Analytics Class Patterns

### Base Analytics Class Structure
```python
class BaseAnalytics:
    """
    Base class for all analytics engines
    Provides common functionality and caching
    """
    
    def __init__(self, user=None, school=None):
        self.user = user
        self.school = school or (user.school if user else None)
        self.cache_timeout = 300  # 5 minutes default
    
    def get_cache_key(self, identifier, *args):
        """Generate consistent cache keys"""
        key_parts = [self.__class__.__name__, identifier]
        key_parts.extend([str(arg) for arg in args])
        return '_'.join(key_parts)
    
    def get_or_calculate(self, cache_key, calculation_func, *args, **kwargs):
        """
        Get from cache or calculate and cache result
        """
        result = cache.get(cache_key)
        if result is None:
            result = calculation_func(*args, **kwargs)
            cache.set(cache_key, result, self.cache_timeout)
        return result
```

### School-Wide Analytics Pattern
```python
class SchoolAnalytics(BaseAnalytics):
    def get_overview(self, start_date, end_date):
        """
        Get comprehensive school overview with caching
        """
        cache_key = self.get_cache_key('overview', self.school.id, start_date, end_date)
        
        return self.get_or_calculate(
            cache_key,
            self._calculate_overview,
            start_date,
            end_date
        )
    
    def _calculate_overview(self, start_date, end_date):
        """Private method for actual calculation"""
        logs = Log.objects.filter(
            school=self.school,
            date__range=(start_date, end_date)
        )
        
        return {
            'basic_stats': logs.aggregate(
                total_logs=Count('id'),
                total_pages=Sum('pages'),
                total_minutes=Sum('minutes'),
                unique_students=Count('student', distinct=True)
            ),
            'daily_breakdown': self._get_daily_breakdown(logs),
            'top_performers': self._get_top_performers(logs)
        }
```

