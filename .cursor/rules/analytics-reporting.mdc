### Pagination for Large Datasets
```python
def get_paginated_results(queryset, page=1, per_page=50):
    """
    Standard pagination for analytics results
    """
    from django.core.paginator import Paginator, EmptyPage
    
    paginator = Paginator(queryset, per_page)
    
    try:
        page_obj = paginator.page(page)
    except EmptyPage:
        page_obj = paginator.page(paginator.num_pages)
    
    return {
        'results': list(page_obj),
        'pagination': {
            'current_page': page_obj.number,
            'total_pages': paginator.num_pages,
            'total_count': paginator.count,
            'has_next': page_obj.has_next(),
            'has_previous': page_obj.has_previous()
        }
    }
```

## Caching Strategies

### Multi-Level Caching Pattern
```python
from django.core.cache import cache
from django.conf import settings

class CachedAnalytics:
    # Different cache timeouts for different data types
    CACHE_TIMEOUTS = {
        'realtime': 60,      # 1 minute for real-time data
        'hourly': 3600,      # 1 hour for hourly aggregations
        'daily': 86400,      # 24 hours for daily summaries
        'static': 604800     # 1 week for historical data
    }
    
    def get_with_cache(self, cache_type, cache_key, calculation_func, *args):
        """
        Get data with appropriate cache timeout
        """
        timeout = self.CACHE_TIMEOUTS.get(cache_type, 300)
        
        data = cache.get(cache_key)
        if data is None:
            data = calculation_func(*args)
            cache.set(cache_key, data, timeout)
            
        return data
```

### Cache Invalidation Pattern
```python
def invalidate_analytics_cache(school_id, student_id=None):
    """
    Invalidate relevant cache keys when data changes
    """
    cache_patterns = [
        f"analytics_school_{school_id}_*",
        f"dashboard_overview_{school_id}_*"
    ]
    
    if student_id:
        cache_patterns.append(f"student_analytics_{student_id}_*")
    
    for pattern in cache_patterns:
        cache.delete_pattern(pattern)
```

## Chart Data Formatting

### Standard Chart Data Structure
```python
def format_chart_data(data, chart_type='line'):
    """
    Format data for frontend chart libraries (Chart.js, etc.)
    """
    if chart_type == 'line':
        return {
            'labels': [item['label'] for item in data],
            'datasets': [{
                'label': 'Reading Progress',
                'data': [item['value'] for item in data],
                'borderColor': 'rgb(75, 192, 192)',
                'backgroundColor': 'rgba(75, 192, 192, 0.2)',
                'tension': 0.1
            }]
        }
    elif chart_type == 'pie':
        return {
            'labels': [item['label'] for item in data],
            'datasets': [{
                'data': [item['value'] for item in data],
                'backgroundColor': [
                    '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF'
                ]
            }]
        }
```

### Time Series Data Formatting
```python
def format_time_series(queryset, date_field='date', value_field='total'):
    """
    Format database results for time series charts
    """
    data = []
    for item in queryset:
        data.append({
            'x': item[date_field].isoformat(),
            'y': float(item[value_field] or 0)
        })
    
    return {
        'datasets': [{
            'label': 'Progress Over Time',
            'data': data,
            'fill': False,
            'borderColor': 'rgb(75, 192, 192)'
        }]
    }
```

## Goal Progress Calculations

### Standardized Goal Progress Formula
```python
def calculate_goal_progress(actual, target, as_percentage=True):
    """
    Calculate progress towards a goal
    """
    if not target or target <= 0:
        return 0
    
    progress = actual / target
    
    if as_percentage:
        return min(100, progress * 100)  # Cap at 100%
    
    return progress

def get_goal_status(progress_percentage):
    """
    Determine goal status based on progress
    """
    if progress_percentage >= 100:
        return 'exceeded'
    elif progress_percentage >= 80:
        return 'on_track'
    elif progress_percentage >= 50:
        return 'behind'
    else:
        return 'struggling'
```

