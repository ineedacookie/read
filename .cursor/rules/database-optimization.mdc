# Database Optimization Guidelines

## Index Strategy

### Primary Index Patterns
```python
class Log(models.Model):
    student = models.ForeignKey(CustomUser, on_delete=models.CASCADE, db_index=True)
    school = models.ForeignKey(School, on_delete=models.CASCADE, db_index=True)
    date = models.DateField(db_index=True)  # Frequently queried for date ranges
    title = models.CharField(max_length=255, blank=True, null=True, db_index=True)
    
    class Meta:
        # Composite indexes for common query patterns
        indexes = [
            models.Index(fields=['school', 'student', 'date']),  # Student progress queries
            models.Index(fields=['school', 'date']),            # School-wide queries  
            models.Index(fields=['student', 'date']),           # Individual student queries
            models.Index(fields=['date', 'school']),            # Date-first analytics
        ]
```

### When to Add Indexes
```python
# ✅ ADD indexes for:
# - Foreign keys (automatically indexed by Django)
# - Fields frequently used in WHERE clauses
# - Fields used in ORDER BY
# - Fields used in JOINs
# - Composite indexes for multi-field queries

# ❌ AVOID indexes on:
# - Fields that are updated frequently
# - Small tables (< 1000 rows)
# - Fields with very low selectivity (boolean fields)
# - Very wide columns (text fields)
```

## Query Optimization Patterns

### Use Select Related for Foreign Keys
```python
# ✅ GOOD: Single query with JOIN
logs = Log.objects.select_related('student', 'school')\
                 .filter(date__gte=start_date)

# ❌ BAD: N+1 queries
logs = Log.objects.filter(date__gte=start_date)
for log in logs:
    print(log.student.name)  # Additional query for each log
```

### Use Prefetch Related for Reverse FKs and M2M
```python
# ✅ GOOD: Prefetch related objects
students = CustomUser.objects.prefetch_related(
    'log_set',           # Reverse FK
    'classrooms',        # M2M
    'reading_groups'     # M2M
).filter(user_type='student')

# Access without additional queries
for student in students:
    for log in student.log_set.all():  # No additional query
        print(log.title)
```

### Use Only() and Defer() for Large Objects
```python
# ✅ GOOD: Only select needed fields
logs = Log.objects.only('id', 'title', 'pages', 'date')\
                 .filter(student=student)

# ✅ GOOD: Defer expensive fields
logs = Log.objects.defer('comments')\
                 .filter(student=student)
```

## Aggregation Optimization

### Database-Level Aggregations
```python
# ✅ GOOD: Database aggregation
stats = Log.objects.filter(student=student).aggregate(
    total_pages=Sum('pages'),
    avg_rating=Avg('rating'),
    log_count=Count('id')
)

# ❌ BAD: Python-level aggregation
logs = Log.objects.filter(student=student)
total_pages = sum(log.pages or 0 for log in logs)
```

### Use Annotations for Calculated Fields
```python
# ✅ GOOD: Database calculation
students = CustomUser.objects.annotate(
    total_pages=Sum('log__pages'),
    avg_rating=Avg('log__rating'),
    log_count=Count('log')
).filter(user_type='student')

# Access calculated fields
for student in students:
    print(f"{student.name}: {student.total_pages} pages")
```

## Constraint Patterns

### Data Integrity Constraints
```python
class Log(models.Model):
    pages = models.IntegerField(blank=True, null=True)
    minutes = models.IntegerField(blank=True, null=True)
    rating = models.DecimalField(
        max_digits=3, decimal_places=2, 
        blank=True, null=True,
        validators=[
            MinValueValidator(0.00),
            MaxValueValidator(5.00)
        ]
    )
    
    class Meta:
        constraints = [
            # Ensure non-negative values
            models.CheckConstraint(
                check=models.Q(pages__gte=0) | models.Q(pages__isnull=True),
                name='pages_non_negative'
            ),
            models.CheckConstraint(
                check=models.Q(minutes__gte=0) | models.Q(minutes__isnull=True),
                name='minutes_non_negative'
            ),
            # Ensure at least one metric is provided
            models.CheckConstraint(
                check=models.Q(pages__isnull=False) | models.Q(minutes__isnull=False),
                name='at_least_one_metric'
            ),
            # Unique constraint for specific combinations
            models.UniqueConstraint(
                fields=['student', 'date', 'title'],
                name='unique_daily_book_log'
            )
        ]
```

## Transaction Management

### Use Atomic Transactions for Related Operations
```python
from django.db import transaction

@transaction.atomic
def create_reading_log_with_achievements(student, log_data):
    """
    Create log and process achievements in single transaction
    """
    # Create the log
    log = Log.objects.create(student=student, **log_data)
    
    # Update student stats
    profile = student.profile
    profile.total_pages += log.pages or 0
    profile.save()
    
    # Check for new achievements
    gamification_engine = GamificationEngine(student)
    badges = gamification_engine.check_achievements_for_log(log)
    
    return log, badges
```

### Savepoint for Nested Transactions
```python
from django.db import transaction

def bulk_process_students(student_ids):
    with transaction.atomic():
        for student_id in student_ids:
            try:
                with transaction.atomic():
                    # Process individual student
                    process_student_analytics(student_id)
            except Exception as e:
                # This student fails, but others continue
                logger.error(f'Failed to process student {student_id}: {e}')
```

## Custom Manager Optimization

### Efficient Custom Managers
```python
class LogManager(models.Manager):
    def for_student(self, student):
        """Get logs for a specific student with common optimizations"""
        return self.select_related('school')\
                  .filter(student=student)\
                  .order_by('-date')
    
    def for_date_range(self, start_date, end_date):
        """Get logs in date range with validation"""
        if start_date > end_date:
            raise ValueError("start_date cannot be after end_date")
            
        return self.select_related('student', 'school')\
                  .filter(date__range=(start_date, end_date))
    
    def with_analytics(self):
        """Include common analytics annotations"""
        return self.annotate(
            student_name=F('student__first_name'),
            school_name=F('school__name')
        )

class Log(models.Model):
    # ... fields ...
    
    objects = LogManager()
```

## Bulk Operations

### Bulk Create for Multiple Records
```python
# ✅ GOOD: Bulk create
logs_to_create = []
for log_data in log_data_list:
    logs_to_create.append(Log(**log_data))

Log.objects.bulk_create(logs_to_create, batch_size=100)

# ❌ BAD: Individual creates
for log_data in log_data_list:
    Log.objects.create(**log_data)  # One query per log
```

### Bulk Update for Multiple Records
```python
# ✅ GOOD: Bulk update
Log.objects.filter(student=student, date__gte=start_date)\
          .update(school=new_school)

# ❌ BAD: Individual updates
logs = Log.objects.filter(student=student, date__gte=start_date)
for log in logs:
    log.school = new_school
    log.save()  # One query per log
```

