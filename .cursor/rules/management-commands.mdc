# Management Commands Standards

## Command Structure Pattern

### Base Command Template
```python
"""
Management command to [description of what the command does]
"""

from django.core.management.base import BaseCommand, CommandError
from django.db import transaction
from django.utils import timezone
from datetime import datetime, date
import logging

# Set up logging
logger = logging.getLogger(__name__)

class Command(BaseCommand):
    help = 'Brief description of what this command does'
    
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.processed_count = 0
        self.error_count = 0
    
    def add_arguments(self, parser):
        """Define command-line arguments"""
        # Required arguments
        parser.add_argument(
            'action',
            choices=['create', 'update', 'delete'],
            help='Action to perform'
        )
        
        # Optional arguments
        parser.add_argument(
            '--school-id',
            type=int,
            help='Process specific school only'
        )
        
        parser.add_argument(
            '--dry-run',
            action='store_true',
            help='Show what would be done without making changes'
        )
        
        parser.add_argument(
            '--force',
            action='store_true',
            help='Force operation even if risks are detected'
        )
        
        parser.add_argument(
            '--batch-size',
            type=int,
            default=100,
            help='Number of records to process in each batch (default: 100)'
        )
    
    def handle(self, *args, **options):
        """Main command logic"""
        self.verbosity = options['verbosity']
        
        try:
            # Validate arguments
            self.validate_arguments(options)
            
            # Perform the operation
            self.perform_operation(options)
            
            # Output summary
            self.output_summary()
            
        except Exception as e:
            logger.error(f'Command failed: {e}')
            raise CommandError(f'Command failed: {e}')
    
    def validate_arguments(self, options):
        """Validate command arguments"""
        pass  # Override in subclasses
    
    def perform_operation(self, options):
        """Perform the main operation"""
        pass  # Override in subclasses
    
    def output_summary(self):
        """Output operation summary"""
        self.stdout.write(
            self.style.SUCCESS(
                f'Operation completed successfully. '
                f'Processed: {self.processed_count}, Errors: {self.error_count}'
            )
        )
```

## Argument Handling Patterns

### Common Argument Types
```python
def add_arguments(self, parser):
    # Date arguments
    parser.add_argument(
        '--start-date',
        type=lambda s: datetime.strptime(s, '%Y-%m-%d').date(),
        default=date.today(),
        help='Start date in YYYY-MM-DD format (default: today)'
    )
    
    # File arguments
    parser.add_argument(
        '--input-file',
        type=argparse.FileType('r'),
        help='Input CSV file'
    )
    
    # Multiple choice arguments
    parser.add_argument(
        '--user-types',
        nargs='+',
        choices=['student', 'teacher', 'parent', 'administrator'],
        default=['student'],
        help='User types to process'
    )
    
    # Boolean flags
    parser.add_argument(
        '--include-inactive',
        action='store_true',
        help='Include inactive users in processing'
    )
    
    # Integer with validation
    parser.add_argument(
        '--limit',
        type=int,
        metavar='N',
        help='Maximum number of records to process'
    )
