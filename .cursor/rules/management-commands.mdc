## Cleanup and Maintenance Commands

### Data Cleanup Pattern
```python
class Command(BaseCommand):
    help = 'Clean up old data and optimize database'
    
    def add_arguments(self, parser):
        parser.add_argument(
            '--days-old',
            type=int,
            default=90,
            help='Delete data older than N days (default: 90)'
        )
        
        parser.add_argument(
            '--cleanup-type',
            choices=['logs', 'sessions', 'all'],
            default='all',
            help='Type of cleanup to perform'
        )
    
    def handle(self, *args, **options):
        days_old = options['days_old']
        cleanup_type = options['cleanup_type']
        
        cutoff_date = timezone.now() - timedelta(days=days_old)
        
        if cleanup_type in ['logs', 'all']:
            self.cleanup_old_logs(cutoff_date, options)
        
        if cleanup_type in ['sessions', 'all']:
            self.cleanup_old_sessions(cutoff_date, options)
    
    def cleanup_old_logs(self, cutoff_date, options):
        """Clean up old log entries"""
        dry_run = options.get('dry_run', False)
        
        old_logs = Log.objects.filter(created_at__lt=cutoff_date)
        count = old_logs.count()
        
        if dry_run:
            self.stdout.write(f'Would delete {count} old log entries')
        else:
            deleted_count = old_logs.delete()[0]
            self.stdout.write(
                self.style.SUCCESS(f'Deleted {deleted_count} old log entries')
            )
```

## Command Testing Patterns

### Management Command Testing
```python
from io import StringIO
from django.core.management import call_command
from django.core.management.base import CommandError
from django.test import TestCase

class CommandTests(TestCase):
    def test_command_success(self):
        """Test successful command execution"""
        out = StringIO()
        call_command('my_command', 'create', stdout=out)
        
        self.assertIn('Operation completed successfully', out.getvalue())
    
    def test_command_with_arguments(self):
        """Test command with specific arguments"""
        out = StringIO()
        call_command(
            'my_command',
            'create',
            '--school-id=1',
            '--batch-size=50',
            stdout=out
        )
        
        self.assertIn('Processed:', out.getvalue())
    
    def test_command_error_handling(self):
        """Test command error handling"""
        with self.assertRaises(CommandError):
            call_command('my_command', 'invalid_action')
    
    def test_dry_run_mode(self):
        """Test dry run functionality"""
        out = StringIO()
        call_command('my_command', 'create', '--dry-run', stdout=out)
        
        output = out.getvalue()
        self.assertIn('DRY RUN MODE', output)
        self.assertIn('Would process', output)
```