## Performance Testing Patterns

### Query Count Testing
```python
from django.test.utils import override_settings
from django.db import connection
from django.test import TransactionTestCase

class PerformanceTests(TransactionTestCase):
    def test_student_dashboard_query_count(self):
        """Test that student dashboard doesn't cause N+1 queries"""
        student = StudentFactory()
        LogFactory.create_batch(10, student=student)
        
        with self.assertNumQueries(3):  # Expected number of queries
            response = self.client.get(
                reverse('student_dashboard'),
                HTTP_AUTHORIZATION=f'Bearer {student.auth_token}'
            )
            
        self.assertEqual(response.status_code, 200)
```

## Integration Testing Patterns

### End-to-End Workflow Testing
```python
class ReadingLogWorkflowTests(BaseTestCase):
    def test_complete_reading_log_workflow(self):
        """Test complete workflow from log creation to badge earning"""
        self.client.force_login(self.student)
        
        # 1. Create reading log via API
        log_data = {
            'title': 'Test Book',
            'author': 'Test Author',
            'pages': 25,
            'minutes': 30,
            'rating': 4.0,
            'date': date.today().isoformat()
        }
        
        response = self.client.post('/api/logs/', data=log_data)
        self.assertEqual(response.status_code, 201)
        
        # 2. Verify log was created
        log = Log.objects.get(student=self.student)
        self.assertEqual(log.title, 'Test Book')
        self.assertEqual(log.pages, 25)
        
        # 3. Check if achievements were triggered
        badges = self.student.studentbadge_set.all()
        self.assertGreater(badges.count(), 0)
        
        # 4. Verify XP was awarded
        profile = self.student.profile
        self.assertGreater(profile.total_xp, 0)
```

## Mock and Patch Patterns

### External Service Mocking
```python
from unittest.mock import patch, Mock

class ExternalServiceTests(BaseTestCase):
    @patch('reading_logs.services.email_service.send_notification')
    def test_badge_notification_sent(self, mock_send_email):
        """Test that email notification is sent when badge is earned"""
        mock_send_email.return_value = True
        
        # Create log that triggers badge
        log = Log.objects.create(
            student=self.student,
            school=self.school,
            date=date.today(),
            pages=10
        )
        
        # Verify email service was called
        mock_send_email.assert_called_once()
        
        # Check call arguments
        call_args = mock_send_email.call_args
        self.assertEqual(call_args[0][0], self.student.email)
        self.assertIn('badge', call_args[0][1].lower())  # Subject contains 'badge'
```

## Test Data Cleanup

### Proper Test Isolation
```python
class IsolatedTestCase(TestCase):
    def setUp(self):
        """Set up test data"""
        self.school = SchoolFactory()
        self.student = StudentFactory(school=self.school)
        
    def tearDown(self):
        """Clean up after each test"""
        # Django automatically rolls back test database
        # Additional cleanup if needed
        cache.clear()
        
    @classmethod
    def setUpClass(cls):
        """One-time setup for entire test class"""
        super().setUpClass()
        # Setup that's expensive and can be shared
        
    @classmethod
    def tearDownClass(cls):
        """One-time cleanup for entire test class"""
        super().tearDownClass()
        # Cleanup shared setup
```

## Assertion Patterns

### Custom Assertions
```python
class CustomAssertionMixin:
    def assertLogEqual(self, log, expected_data):
        """Custom assertion for log objects"""
        self.assertEqual(log.title, expected_data['title'])
        self.assertEqual(log.pages, expected_data['pages'])
        self.assertEqual(log.student.id, expected_data['student_id'])
        
    def assertBadgeEarned(self, student, badge_name):
        """Assert that student earned specific badge"""
        badges = student.studentbadge_set.filter(badge__name=badge_name)
        self.assertTrue(badges.exists(), f"Student did not earn badge: {badge_name}")
        
    def assertValidJSONResponse(self, response, expected_status='success'):
        """Assert valid JSON API response format"""
        self.assertEqual(response.status_code, 200)
        data = response.json()
        self.assertIn('status', data)
        self.assertEqual(data['status'], expected_status)
        if expected_status == 'success':
            self.assertIn('data', data)
```