# Testing Standards and Patterns

## Test Structure and Organization

### Test File Organization
```python
# tests/
#   __init__.py
#   test_models.py      # Model tests
#   test_views.py       # View/API tests  
#   test_apis.py        # API endpoint tests
#   test_gamification.py # Gamification system tests
#   test_analytics.py    # Analytics tests
#   factories.py         # Test data factories
#   utils.py            # Test utilities
```

### Base Test Case Pattern
```python
from django.test import TestCase, Client
from django.contrib.auth import get_user_model
from django.urls import reverse
from datetime import date, timedelta

from users.models import School, CustomUser
from reading_logs.models import Log, DailyGoal

User = get_user_model()

class BaseTestCase(TestCase):
    """Base test case with common setup"""
    
    def setUp(self):
        self.client = Client()
        
        # Create test school
        self.school = School.objects.create(name="Test School")
        
        # Create test users for each role
        self.administrator = self.create_user('admin', 'administrator')
        self.teacher = self.create_user('teacher', 'teacher')
        self.student = self.create_user('student', 'student')
        self.parent = self.create_user('parent', 'parent')
        
    def create_user(self, username, user_type):
        """Helper to create users with consistent pattern"""
        return CustomUser.objects.create(
            username=f"test{username}",
            email=f"{username}@test.com",
            user_type=user_type,
            school=self.school,
            first_name=f"Test {username.title()}",
            last_initial="T"
        )
```

## API Testing Patterns

### Authentication Testing
```python
class APIAuthenticationTests(BaseTestCase):
    def test_unauthenticated_access_denied(self):
        """Test that unauthenticated users cannot access APIs"""
        response = self.client.get('/api/logs/')
        self.assertEqual(response.status_code, 302)  # Redirect to login
        
    def test_authenticated_access_allowed(self):
        """Test that authenticated users can access appropriate APIs"""
        self.client.force_login(self.student)
        response = self.client.get('/api/logs/')
        self.assertEqual(response.status_code, 200)
```

### Permission Testing Pattern
```python
class APIPermissionTests(BaseTestCase):
    def setUp(self):
        super().setUp()
        
        # Create test data for different users
        self.student_log = Log.objects.create(
            student=self.student,
            school=self.school,
            date=date.today(),
            pages=10,
            minutes=20
        )
        
    def test_student_can_only_see_own_logs(self):
        """Students should only see their own reading logs"""
        self.client.force_login(self.student)
        
        response = self.client.get('/api/logs/')
        data = response.json()
        
        self.assertEqual(response.status_code, 200)
        self.assertEqual(len(data['logs']), 1)
        self.assertEqual(data['logs'][0]['id'], self.student_log.id)
        
    def test_teacher_sees_student_logs_in_class(self):
        """Teachers should see logs for students in their classes"""
        # Add student to teacher's classroom
        classroom = Classroom.objects.create(name="Test Class", school=self.school)
        classroom.teachers.add(self.teacher)
        classroom.students.add(self.student)
        
        self.client.force_login(self.teacher)
        
        response = self.client.get('/api/logs/')
        data = response.json()
        
        self.assertEqual(response.status_code, 200)
        self.assertGreater(len(data['logs']), 0)
```

### JSON Response Testing
```python
class APIResponseFormatTests(BaseTestCase):
    def test_success_response_format(self):
        """Test that successful API responses follow standard format"""
        self.client.force_login(self.student)
        
        response = self.client.get('/api/logs/')
        data = response.json()
        
        # Check standard response structure
        self.assertIn('status', data)
        self.assertEqual(data['status'], 'success')
        self.assertIn('data', data)
        
    def test_error_response_format(self):
        """Test that error responses follow standard format"""
        response = self.client.get('/api/logs/invalid-id/')
        data = response.json()
        
        self.assertIn('status', data)
        self.assertEqual(data['status'], 'error')
        self.assertIn('message', data)
        self.assertIsInstance(data['message'], str)
```

## Model Testing Patterns

### Model Validation Testing
```python
class LogModelTests(BaseTestCase):
    def test_log_creation_with_valid_data(self):
        """Test creating a log with valid data"""
        log = Log.objects.create(
            student=self.student,
            school=self.school,
            date=date.today(),
            title="Test Book",
            author="Test Author",
            pages=10,
            minutes=20,
            rating=4.5
        )
        
        self.assertEqual(log.student, self.student)
        self.assertEqual(log.school, self.school)
        self.assertEqual(log.pages, 10)
        self.assertEqual(log.rating, 4.5)
        
    def test_negative_pages_validation(self):
        """Test that negative pages are not allowed"""
        with self.assertRaises(ValidationError):
            log = Log(
                student=self.student,
                school=self.school,
                date=date.today(),
                pages=-5  # Invalid negative value
            )
            log.full_clean()  # Trigger validation
            
    def test_rating_range_validation(self):
        """Test that ratings must be between 0 and 5"""
        # Test invalid high rating
        with self.assertRaises(ValidationError):
            log = Log(
                student=self.student,
                school=self.school,
                date=date.today(),
                rating=6.0  # Invalid high rating
            )
            log.full_clean()
```

