## Factory Pattern for Test Data

### Model Factories
```python
# tests/factories.py
import factory
from datetime import date
from django.contrib.auth import get_user_model

from users.models import School
from reading_logs.models import Log

User = get_user_model()

class SchoolFactory(factory.django.DjangoModelFactory):
    class Meta:
        model = School
        
    name = factory.Sequence(lambda n: f"Test School {n}")

class UserFactory(factory.django.DjangoModelFactory):
    class Meta:
        model = User
        
    username = factory.Sequence(lambda n: f"testuser{n}")
    email = factory.LazyAttribute(lambda obj: f"{obj.username}@test.com")
    first_name = factory.Faker('first_name')
    last_initial = factory.Faker('random_letter')
    school = factory.SubFactory(SchoolFactory)
    
class StudentFactory(UserFactory):
    user_type = 'student'
    
class TeacherFactory(UserFactory):
    user_type = 'teacher'

class LogFactory(factory.django.DjangoModelFactory):
    class Meta:
        model = Log
        
    student = factory.SubFactory(StudentFactory)
    school = factory.SelfAttribute('student.school')
    date = factory.LazyFunction(date.today)
    title = factory.Faker('sentence', nb_words=3)
    author = factory.Faker('name')
    pages = factory.Faker('random_int', min=1, max=50)
    minutes = factory.Faker('random_int', min=5, max=120)
    rating = factory.Faker('pydecimal', left_digits=1, right_digits=2, positive=True, min_value=0, max_value=5)
```

